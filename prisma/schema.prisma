// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// datasource db {
//   provider = "sqlite"
//   url      = env("DATABASE_URL")
// }
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Eventos creados por este usuario
  eventos   Evento[]
}

model Contacto {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  mensaje   String
  createdAt DateTime @default(now())
}

// ── Eventos ──
model Evento {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  category    String   // "ec" | "gl"
  tagLabel    String   // "Explorando Ciencias" | "Generando Lazos"
  image       String
  location    String?
  featured    Boolean  @default(false)

  // Usuario creador
  creatorId   Int
  creator     User     @relation(fields: [creatorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Oportunidades ──
model Oportunidad {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  deadline     DateTime?
  type         String   // "becas" | "traslados" | "congresos" | "financiamientos"
  externalLink String?
  image        String?
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Blog / Noticias ──
model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  author    String
  image     String?
  tags      String   @default("") // comma-separated
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

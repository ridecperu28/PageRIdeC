// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contacto {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  mensaje   String
  createdAt DateTime @default(now())
}

// ── Eventos ──
model Evento {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  category    String   // "ec" | "gl"
  tagLabel    String   // "Explorando Ciencias" | "Generando Lazos"
  image       String
  location    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Oportunidades ──
model Oportunidad {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  deadline     DateTime?
  type         String   // "becas" | "traslados" | "congresos" | "financiamientos"
  externalLink String?
  image        String?
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Blog / Noticias ──
model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  author    String
  image     String?
  tags      String   @default("") // comma-separated
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Stats del homepage ──
model Stat {
  id     Int    @id @default(autoincrement())
  number String // "350+"
  label  String // "Estudiantes activos"
  order  Int    @default(0)
}

// ── Features / Qué hacemos ──
model Feature {
  id          Int    @id @default(autoincrement())
  icon        String // emoji
  title       String
  description String
  href        String?
  order       Int    @default(0)
}

// ── ODS ──
model Ods {
  id          Int    @id @default(autoincrement())
  number      Int    // 4, 5, 9, 10
  title       String
  description String
  image       String
  order       Int    @default(0)
}

// ── Mesa Directiva / Equipo ──
model TeamMember {
  id    Int    @id @default(autoincrement())
  name  String
  role  String
  image String
  order Int    @default(0)
}
